{
  "name": "san-sebastian-cafe",
  "private": true,
  "packageManager": "npm@11.4.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@ssc/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "npm run test:integration -w @ssc/db -w @ssc/web",
    "test:e2e": "npm run test:e2e -w @ssc/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "npm run generate -w @ssc/db --",
    "db:migrate": "npm run migrate -w @ssc/db",
    "db:seed": "npm run seed -w @ssc/db",
    "db:purge-demo": "npm run purge-demo -w @ssc/db",
    "db:reset": "npm run reset -w @ssc/db",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "zod": "^4.6.7"
  }
}
