# Copy to .env (root). Validated at startup by packages/env — the app refuses to boot on invalid values.

# development | test | staging | production
APP_ENV=development
LOG_LEVEL=debug

# Local Docker Postgres (see docker-compose.yml). Port 5442 avoids clashing with other local Postgres instances.
DATABASE_URL=postgres://ssc:ssc_dev_password@localhost:5442/ssc_dev
# Used by integration tests only. Tests TRUNCATE this database — never point it at real data.
DATABASE_URL_TEST=postgres://ssc:ssc_dev_password@localhost:5442/ssc_test

# Public base URL of the web app
BETTER_AUTH_URL=http://localhost:3000
# >= 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-me-with-a-random-32-plus-character-secret

# Email delivery for sign-in codes. "console" logs codes to the server terminal (development only).
EMAIL_TRANSPORT=console
EMAIL_FROM="San Sebastian Café <no-reply@example.invalid>"

# Used by Playwright end-to-end tests only. Reset and re-seeded on every E2E run.
DATABASE_URL_E2E=postgres://ssc:ssc_dev_password@localhost:5442/ssc_e2e

# Payment boundary: "none" (orders cannot be placed), "fake" (development simulator — no money moves;
# refused in staging/production) or "stripe" (Stripe Checkout; see docs/13-payments.md).
PAYMENT_PROVIDER=fake

# Stripe — TEST-MODE keys only outside production (live keys are refused). Dashboard → Developers → API keys.
# A restricted key (rk_test_…) with Checkout Sessions, PaymentIntents, Refunds, Customers write access works too.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint, or the one printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=

# Bearer secret for the scheduled jobs: payment recovery (GET /api/cron/payments, every 5–10 min) and
# privacy retention (GET /api/cron/retention, daily). Leave empty to disable both.
CRON_SECRET=

# Product photos: "local" (files in apps/web/.dev-uploads; development only) or "vercel-blob" (a public Vercel Blob store).
STORAGE_DRIVER=local
# With vercel-blob: Vercel sets BLOB_STORE_ID when the store is connected. Outside Vercel, use the store's read-write token instead.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
