# Copy to .env (root). Validated at startup by packages/env — the app refuses to boot on invalid values.

# development | test | staging | production
APP_ENV=development
LOG_LEVEL=debug

# Local Docker Postgres (see docker-compose.yml). Port 5442 avoids clashing with other local Postgres instances.
DATABASE_URL=postgres://ssc:ssc_dev_password@localhost:5442/ssc_dev
# Used by integration tests only. Tests TRUNCATE this database — never point it at real data.
DATABASE_URL_TEST=postgres://ssc:ssc_dev_password@localhost:5442/ssc_test

# Public base URL of the web app
BETTER_AUTH_URL=http://localhost:3000
# >= 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-me-with-a-random-32-plus-character-secret

# Email delivery for sign-in codes. "console" logs codes to the server terminal (development only).
EMAIL_TRANSPORT=console
EMAIL_FROM="San Sebastian Café <no-reply@example.invalid>"

# Used by Playwright end-to-end tests only. Reset and re-seeded on every E2E run.
DATABASE_URL_E2E=postgres://ssc:ssc_dev_password@localhost:5442/ssc_e2e

# Payment boundary: "none" (orders cannot be placed) or "fake" (development simulator — no money moves;
# refused in staging/production). Real providers arrive in Phase 6.
PAYMENT_PROVIDER=fake
